<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Praxicraft.Assess</RootNamespace>
    <AssemblyName>Praxicraft.Assess</AssemblyName>
    <PackageId>Praxicraft.Assess</PackageId>
    <Version>0.1.1</Version>
    <Authors>PraxiCraft</Authors>
    <Company>PraxiCraft</Company>
    <Description>Official .NET SDK for the Praxicraft Assess Public API</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.praxicraft.com/sdks/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/praxicraft-platform/praxicraft-dotnet</RepositoryUrl>
    <PackageTags>praxicraft;assess;hiring;api</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
